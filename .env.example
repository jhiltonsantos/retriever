# Selecao do provedor de LLM: "ollama" (local) ou "openrouter" (remoto)
LLM_PROVIDER=openrouter

# Modelo do LLM. Vazio deixa o provedor ativo escolher o default certo
# (nao existe um valor unico: um id do OpenRouter nao e um nome do Ollama).
LLM_MODEL=

# Credencial e URL base genericas do provedor remoto ativo.
# Hoje usadas pelo provider OpenRouter; nomeadas de forma generica para
# a futura tela de configuracao (F-SETTINGS) nao ficar acoplada a um provedor.
LLM_API_KEY=
LLM_API_BASE_URL=https://openrouter.ai/api/v1

# Ollama local. Sempre necessario, mesmo com LLM_PROVIDER=openrouter,
# porque os embeddings sao sempre locais.
OLLAMA_BASE_URL=http://localhost:11434
