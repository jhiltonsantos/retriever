{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Retriever",
  "version": "0.1.0",
  "identifier": "com.retriever.app",
  "build": {
    "frontendDist": "../../retriever-web/build",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../retriever-web"
  },
  "app": {
    "windows": [
      {
        "title": "Retriever",
        "width": 1100,
        "height": 800,
        "minWidth": 720,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/retriever-api"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
